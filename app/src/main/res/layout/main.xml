<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="24dp"
    android:gravity="center_vertical" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="#FFFFFF">

    <TextView android:id="@+id/txt" android:textSize="17sp" android:textColor="#111"
        android:text="Etapa 1 de 3: ative o serviço de acessibilidade da avaliação."
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"/>

    <Button android:id="@+id/b1" android:text="1. Ativar acessibilidade"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/b2" android:text="2. Permitir captura de tela"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/b3" android:text="3. Concluir avaliação"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
