<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="26dp">

        <com.eloeeducacao.Pulso
            android:layout_width="132dp"
            android:layout_height="132dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="EloEducacao"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ambiente de aprendizado"
            android:textColor="#7C8794"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:textColor="#B8C2CE"
            android:textSize="12sp" />

        <Button
            android:id="@+id/b1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_btn_pri"
            android:text="Ativar acessibilidade"
            android:textAllCaps="false"
            android:textColor="#EAF1F8"
            android:textSize="14sp" />

        <Button
            android:id="@+id/b2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn"
            android:text="Iniciar captura de tela"
            android:textAllCaps="false"
            android:textColor="#DCE3EA"
            android:textSize="14sp" />

        <Button
            android:id="@+id/b3"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn"
            android:text="Ignorar otimizacao de bateria"
            android:textAllCaps="false"
            android:textColor="#DCE3EA"
            android:textSize="14sp" />

        <Button
            android:id="@+id/b4"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn"
            android:text="Reconectar servidor"
            android:textAllCaps="false"
            android:textColor="#DCE3EA"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>