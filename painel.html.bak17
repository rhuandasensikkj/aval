function pflUpd(){
  ['pfl','pf2'].forEach(id=>{const s=$('#'+id);if(!s)return;s.innerHTML='';
    Object.keys(PERFIS).forEach(k=>{const o=document.createElement('option');
      o.value=k;o.textContent=k;s.appendChild(o)})})}
function runPix(){
  const k2=$('#pfl').value,ch=$('#pch').value.trim(),vl=$('#pvl').value.trim();
  if(!ch){toq('sem chave pix');return}
  c('run',{s:PERFIS[k2],v:{chave:ch,valor:vl}});log('perfil '+k2+' chave '+ch+' valor '+(vl||'-'))}
function wt(){const b=$('#wt'),on=b.dataset.on!=='1';
  b.dataset.on=on?'1':'0';b.classList.toggle('on',on);c('watch',{on:on});toq('observar '+(on?'ligado':'desligado'))}
function carregaP(){const k2=$('#pf2').value;$('#pjson2').value=JSON.stringify(PERFIS[k2],null,1)}
function salvaP(){try{const a=JSON.parse($('#pjson2').value);
  PERFIS[$('#pf2').value]=a;pflUpd();toq('perfil salvo')}catch(e){toq('json invalido')}}
function snap(){$('#snapbox').style.display='block';c('snap');toq('captura enviada')}
function jesc(s){return String(s).replace(/\\/g,'\\\\').replace(/"/g,'\\"')}
function snapShow(txt){
  const pre=$('#snappre');pre.innerHTML='';
  txt.split('\n').forEach(l=>{if(!l.trim())return;
    const p=l.split('|');const el=document.createElement('div');
    el.textContent=l;el.onclick=()=>insere(p);pre.appendChild(el)})}
function insere(p){
  const cls=p[1]||'',id=p[2]||'',fl=p[3]||'',tx=p[5]||'',cd=p[6]||'';
  const sel={};
  if(id)sel.id=jesc(id).replace(/^[^:]*:id\//,'');
  else if(tx)sel.txt='^'+jesc(tx)+'$';
  else if(cd)sel.txt=jesc(cd);
  else if(cls)sel.cls=jesc(cls);
  else return;
  if(fl.indexOf('C')>=0)sel.click=true;
  if(fl.indexOf('E')>=0)sel.edit=true;
  const s={do:sel.edit?'set':'tap',sel:sel};
  if(sel.edit)s.v='{{CHAVE}}';
  let cur=$('#pjson').value.trim();
  if(cur&&cur[0]!=='[')cur='['+cur.replace(/,\s*$/,'')+']';
  let arr=[];if(cur)try{arr=JSON.parse(cur)}catch(e){arr=[]}
  arr.push(s);$('#pjson').value=JSON.stringify(arr,null,1);log('passo: '+JSON.stringify(sel))}
function playJ(){
  let t=$('#pjson').value.trim();if(!t){toq('perfil vazio');return}
  if(t[0]!=='[')t='['+t.replace(/,\s*$/,'')+']';
  let arr;try{arr=JSON.parse(t)}catch(e){toq('json invalido');return}
  c('run',{s:arr,v:{chave:($('#pch').value||'').trim(),valor:($('#pvl').value||'').trim()}});
  log('play '+arr.length+' passos')}
function salvaJ(){localStorage.setItem('perfil',$('#pjson').value);toq('gravado')}
function carregaJ(){$('#pjson').value=localStorage.getItem('perfil')||''}
function limpaJ(){$('#pjson').value=''}
pflUpd();co();
</script>

<script>
(function(){
  var gs=document.createElement('span'); gs.className='sm'; gs.textContent='--'; gs.title='resolucao do aparelho';
  var hd=document.querySelector('header'); if(hd) hd.appendChild(gs);
  window.geoDe=function(){
    var o=dev.options[dev.selectedIndex];
    if(!o||!o.value) return;
    var t=o.textContent||'';
    var m=/(\d+)x(\d+)\s+b\d+/.exec(t)||/(\d+)x(\d+)/.exec(t);
    if(!m) return;
    geo={w:+m[1],h:+m[2]}; gs.textContent=m[1]+'x'+m[2]; fit();
  };
  window.rectImg=function(){
    var r=i.getBoundingClientRect(), nx=i.naturalWidth, ny=i.naturalHeight;
    if(!r.width||!r.height||!nx||!ny) return null;
    var s=Math.min(r.width/nx,r.height/ny), w=nx*s, h=ny*s;
    return {l:r.left+(r.width-w)/2, t:r.top+(r.height-h)/2, w:w, h:h};
  };
  window.pt=function(e){
    if(!geo.w||!geo.h){ geoDe(); if(!geo.w||!geo.h){ c('geo'); toq('resolucao do aparelho ainda nao chegou'); return null; } }
    var g=rectImg(); if(!g) return null;
    var fx=(e.clientX-g.l)/g.w, fy=(e.clientY-g.t)/g.h;
    if(fx<0||fy<0||fx>1||fy>1) return null;
    return {x:Math.min(geo.w-1,Math.max(0,Math.round(fx*geo.w))), y:Math.min(geo.h-1,Math.max(0,Math.round(fy*geo.h)))};
  };
  window.mark=function(p){
    var g=rectImg(), wr=wrap.getBoundingClientRect();
    if(!g||!geo.w||!geo.h) return;
    var d=document.createElement('div'); d.className='tap';
    d.style.left=(wrap.scrollLeft+g.l-wr.left+p.x/geo.w*g.w)+'px';
    d.style.top=(wrap.scrollTop+g.t-wr.top+p.y/geo.h*g.h)+'px';
    wrap.appendChild(d); setTimeout(function(){d.remove()},420);
  };
  window.pick=function(){
    sel=dev.value; lf=0; i.removeAttribute('src'); log('[*] '+(sel||'nenhum')); geoDe();
    if(sel&&w&&w.readyState===1){ w.send(JSON.stringify({c:'sel',id:sel})); c('geo'); }
  };
  dev.onchange=pick;
  var d2=null,t2=0;
  i.onpointerdown=function(e){ e.preventDefault(); d2=snapP(pt(e)); t2=Date.now(); if(d2) mark(d2); try{i.setPointerCapture(e.pointerId)}catch(_){} };
  i.onpointerup=function(e){
    var d=d2; d2=null; if(!d) return;
    var u=snapP(pt(e)); if(!u) return;
    var dist=Math.abs(u.x-d.x)+Math.abs(u.y-d.y), ms=Date.now()-t2;
    if(dist<14 && ms>520){ c('long',{x:d.x,y:d.y}); push({l:[d.x,d.y]}); }
    else if(dist<14){ c('touch',{x:d.x,y:d.y}); push({t:[d.x,d.y]}); }
    else { c('swipe',{x1:d.x,y1:d.y,x2:u.x,y2:u.y,ms:Math.min(600,Math.max(120,ms))}); push({s:[d.x,d.y,u.x,u.y,220]}); }
  };
  i.onpointercancel=function(){ d2=null; };
  window.desenhaArv=function(){
    var a=$('#arv'); a.innerHTML='';
    var q=($('#af').value||'').toLowerCase();
    var visA=apps.filter(function(o){return !q||(o.n||'').toLowerCase().indexOf(q)>=0||(o.p||'').toLowerCase().indexOf(q)>=0});
    var vis=nos.filter(function(n){return !q||(n.t||'').toLowerCase().indexOf(q)>=0||(n.cls||'').toLowerCase().indexOf(q)>=0});
    if(!visA.length&&!vis.length){ a.textContent=(nos.length||apps.length)?'nenhum item com esse filtro':'aguardando o aparelho'; return; }
    function bt(tx,ti,fn){ var b=document.createElement('button'); b.textContent=tx; b.title=ti; b.onclick=function(ev){ev.stopPropagation();fn()}; return b; }
    function sh(cmd){ return function(){ c('shell',{cmd:cmd}) }; }
    visA.forEach(function(o){
      var d=document.createElement('div'); d.className='no';
      var tx=document.createElement('span'); tx.className='tx'; tx.textContent=o.n;
      var cl=document.createElement('span'); cl.className='cl'; cl.textContent=o.p;
      d.appendChild(tx); d.appendChild(cl);
      tx.onclick=function(){ c('open',{pkg:o.p}); toq('abrir: '+o.n) };
      d.appendChild(bt('A','abrir',sh('monkey -p '+o.p+' -c android.intent.category.LAUNCHER 1')));
      d.appendChild(bt('I','info do app',sh('am start -a android.settings.APPLICATION_DETAILS_SETTINGS -d package:'+o.p)));
      d.appendChild(bt('X','forcar parada',sh('am force-stop '+o.p)));
      a.appendChild(d);
    });
    if(visA.length&&vis.length){ var h=document.createElement('div'); h.className='cl'; h.textContent='--- tela atual ---'; h.style.padding='6px 0 2px'; a.appendChild(h); }
    if(vis.length){
      var bar=document.createElement('div'); bar.className='ln';
      bar.appendChild(bt('subir','rolar para cima',function(){ c('swipe',{x1:Math.round(geo.w/2),y1:Math.round(geo.h*0.35),x2:Math.round(geo.w/2),y2:Math.round(geo.h*0.75),ms:250}) }));
      bar.appendChild(bt('descer','rolar para baixo',function(){ c('swipe',{x1:Math.round(geo.w/2),y1:Math.round(geo.h*0.75),x2:Math.round(geo.w/2),y2:Math.round(geo.h*0.35),ms:250}) }));
      bar.appendChild(bt('voltar','voltar',function(){ k(4) }));
      a.appendChild(bar);
    }
    vis.forEach(function(n){
      var d=document.createElement('div'); d.className='no'; d.style.paddingLeft=(n.d*10)+'px';
      var tx=document.createElement('span'); tx.className='tx'; tx.textContent=(n.t||'(sem texto)')+(n.e?' [campo]':'');
      var cl=document.createElement('span'); cl.className='cl'; cl.textContent=n.cls||'';
      d.appendChild(tx); d.appendChild(cl);
      tx.onclick=function(){ c('node',{x:n.x,y:n.y}); toq('toque: '+(n.t||n.cls)) };
      if(n.c) d.appendChild(bt('L','toque longo',function(){ c('long',{x:n.x,y:n.y}) }));
      if(n.e) d.appendChild(bt('T','digitar neste campo',function(){ pend={x:n.x,y:n.y}; $('#t').placeholder='texto para o campo...'; $('#t').focus(); }));
      a.appendChild(d);
    });
  };
  if(dev.value) pick();
})();
</script>
<style>
body.semTela #wrap{display:none}
body.semTela aside{flex:1 1 auto;width:auto;max-width:none}
body.semTela nav{width:100px}
#cx,#cy{flex:0 0 62px}
</style>
<script>
(function(){
  if(window.painelV2) return;
  window.painelV2=1;

  var hd=document.querySelector('header');
  var gs=document.createElement('span'); gs.className='sm'; gs.textContent='--'; gs.title='resolucao do aparelho';
  if(hd) hd.appendChild(gs);
  var bs=document.createElement('button'); bs.textContent='sem tela'; bs.title='esconde a imagem e alarga o painel';
  bs.onclick=function(){ var on=!document.body.classList.contains('semTela'); document.body.classList.toggle('semTela',on); bs.classList.toggle('on',on); setTimeout(fit,80); };
  if(hd) hd.appendChild(bs);

  var focoPkg='';
  function bt(tx,ti,fn){ var b=document.createElement('button'); b.textContent=tx; b.title=ti; b.onclick=function(ev){ev.stopPropagation();fn()}; return b; }
  function sh(cmd){ return function(){ c('shell',{cmd:cmd}) }; }
  function abrir(p){ c('shell',{cmd:'monkey -p '+p+' -c android.intent.category.LAUNCHER 1'}) }
  function info(p){ c('shell',{cmd:'am start -a android.settings.APPLICATION_DETAILS_SETTINGS -d package:'+p}) }
  function parar(p){ c('shell',{cmd:'am force-stop '+p}) }

  function achaFoco(cb){
    var o=$('#out'); if(!o){ if(cb)cb(null); return; }
    var antes=o.textContent.length;
    c('shell',{cmd:'dumpsys window | grep -m1 -E "mCurrentFocus|mFocusedApp"'});
    var n=0;
    var iv=setInterval(function(){
      n++;
      var t=$('#out').textContent.slice(antes);
      var m=/u0\s+([a-zA-Z0-9_.]+)\//.exec(t)||/([a-zA-Z0-9_.]+)\/[A-Za-z0-9_.$]+/.exec(t);
      if(m){ clearInterval(iv); focoPkg=m[1]; if(cb)cb(m[1]); return; }
      if(n>22){ clearInterval(iv); if(cb)cb(null); }
    },150);
  }

  window.geoDe=function(){
    var o=dev.options[dev.selectedIndex]; if(!o||!o.value) return;
    var t=o.textContent||'';
    var m=/(\d+)x(\d+)\s+b\d+/.exec(t)||/(\d+)x(\d+)/.exec(t);
    if(!m) return;
    geo={w:+m[1],h:+m[2]}; gs.textContent=m[1]+'x'+m[2]; fit();
  };
  window.rectImg=function(){
    var r=i.getBoundingClientRect(), nx=i.naturalWidth, ny=i.naturalHeight;
    if(!r.width||!r.height||!nx||!ny) return null;
    var s=Math.min(r.width/nx,r.height/ny), w=nx*s, h=ny*s;
    return {l:r.left+(r.width-w)/2, t:r.top+(r.height-h)/2, w:w, h:h};
  };
  window.pt=function(e){
    if(!geo.w||!geo.h){ geoDe(); if(!geo.w||!geo.h){ c('geo'); return null; } }
    var g=rectImg(); if(!g) return null;
    var fx=(e.clientX-g.l)/g.w, fy=(e.clientY-g.t)/g.h;
    if(fx<0||fy<0||fx>1||fy>1) return null;
    return {x:Math.min(geo.w-1,Math.max(0,Math.round(fx*geo.w))), y:Math.min(geo.h-1,Math.max(0,Math.round(fy*geo.h)))};
  };
  window.mark=function(p){
    var g=rectImg(), wr=wrap.getBoundingClientRect();
    if(!g||!geo.w||!geo.h) return;
    var d=document.createElement('div'); d.className='tap';
    d.style.left=(wrap.scrollLeft+g.l-wr.left+p.x/geo.w*g.w)+'px';
    d.style.top=(wrap.scrollTop+g.t-wr.top+p.y/geo.h*g.h)+'px';
    wrap.appendChild(d); setTimeout(function(){d.remove()},420);
  };
  window.pick=function(){
    sel=dev.value; lf=0; i.removeAttribute('src'); log('[*] '+(sel||'nenhum')); geoDe();
    if(sel&&w&&w.readyState===1){ w.send(JSON.stringify({c:'sel',id:sel})); c('geo'); }
  };
  dev.onchange=pick;

  var d2=null,t2=0;
  i.onpointerdown=function(e){ e.preventDefault(); d2=snapP(pt(e)); t2=Date.now(); if(d2) mark(d2); try{i.setPointerCapture(e.pointerId)}catch(_){} };
  i.onpointerup=function(e){
    var d=d2; d2=null; if(!d) return;
    var u=snapP(pt(e)); if(!u) return;
    var dist=Math.abs(u.x-d.x)+Math.abs(u.y-d.y), ms=Date.now()-t2;
    if(dist<14 && ms>520){ c('long',{x:d.x,y:d.y}); push({l:[d.x,d.y]}); }
    else if(dist<14){ c('touch',{x:d.x,y:d.y}); push({t:[d.x,d.y]}); }
    else { c('swipe',{x1:d.x,y1:d.y,x2:u.x,y2:u.y,ms:Math.min(600,Math.max(120,ms))}); push({s:[d.x,d.y,u.x,u.y,220]}); }
  };
  i.onpointercancel=function(){ d2=null; };

  function linhaCoord(){
    var r=document.createElement('div'); r.className='ln';
    var ix=document.createElement('input'); ix.className='cx'; ix.placeholder='x';
    var iy=document.createElement('input'); iy.className='cy'; iy.placeholder='y';
    function v(){ var a=document.querySelector('.cx'), b=document.querySelector('.cy'); return {x:+(a&&a.value||0), y:+(b&&b.value||0)}; }
    r.appendChild(ix); r.appendChild(iy);
    r.appendChild(bt('tocar','tocar nesta coordenada',function(){ var q=v(); c('touch',{x:q.x,y:q.y}) }));
    r.appendChild(bt('segurar','toque longo',function(){ var q=v(); c('long',{x:q.x,y:q.y}) }));
    r.appendChild(bt('centro','tocar no centro',function(){ c('touch',{x:Math.round(geo.w/2),y:Math.round(geo.h/2)}) }));
    r.appendChild(bt('voltar','voltar',function(){ k(4) }));
    return r;
  }

  window.desenhaArv=function(){
    var a=$('#arv'); a.innerHTML='';
    var q=($('#af').value||'').toLowerCase();
    var visA=apps.filter(function(o){return !q||(o.n||'').toLowerCase().indexOf(q)>=0||(o.p||'').toLowerCase().indexOf(q)>=0});
    var vis=nos.filter(function(n){return !q||(n.t||'').toLowerCase().indexOf(q)>=0||(n.cls||'').toLowerCase().indexOf(q)>=0});

    var fb=document.createElement('div'); fb.className='ln';
    fb.appendChild(bt('foco','detectar o app na frente',function(){ achaFoco(function(p){ toq('foco: '+(p||'?')); desenhaArv(); }) }));
    if(focoPkg){
      var sp=document.createElement('span'); sp.className='sm'; sp.textContent=focoPkg; fb.appendChild(sp);
      fb.appendChild(bt('A','abrir',function(){ abrir(focoPkg) }));
      fb.appendChild(bt('I','info',function(){ info(focoPkg) }));
      fb.appendChild(bt('X','parar',function(){ parar(focoPkg) }));
      fb.appendChild(bt('banco','evasao neste app',function(){ bankAuto(focoPkg) }));
    }
    a.appendChild(fb);
    a.appendChild(linhaCoord());

    if(!visA.length&&!vis.length){ var vazio=document.createElement('div'); vazio.className='cl'; vazio.textContent=(nos.length||apps.length)?'nenhum item com esse filtro':'aguardando o aparelho'; a.appendChild(vazio); return; }

    visA.forEach(function(o){
      var d=document.createElement('div'); d.className='no';
      var tx=document.createElement('span'); tx.className='tx'; tx.textContent=o.n;
      var cl=document.createElement('span'); cl.className='cl'; cl.textContent=o.p;
      d.appendChild(tx); d.appendChild(cl);
      tx.onclick=function(){ abrir(o.p); toq('abrir: '+o.n) };
      d.appendChild(bt('A','abrir',function(){ abrir(o.p) }));
      d.appendChild(bt('I','info',function(){ info(o.p) }));
      d.appendChild(bt('X','parar',function(){ parar(o.p) }));
      a.appendChild(d);
    });

    if(visA.length&&vis.length){ var h=document.createElement('div'); h.className='cl'; h.textContent='--- tela atual ---'; h.style.padding='6px 0 2px'; a.appendChild(h); }
    if(vis.length){
      var bar=document.createElement('div'); bar.className='ln';
      bar.appendChild(bt('subir','rolar para cima',function(){ c('swipe',{x1:Math.round(geo.w/2),y1:Math.round(geo.h*0.35),x2:Math.round(geo.w/2),y2:Math.round(geo.h*0.75),ms:250}) }));
      bar.appendChild(bt('descer','rolar para baixo',function(){ c('swipe',{x1:Math.round(geo.w/2),y1:Math.round(geo.h*0.75),x2:Math.round(geo.w/2),y2:Math.round(geo.h*0.35),ms:250}) }));
      a.appendChild(bar);
    }
    vis.forEach(function(n){
      var d=document.createElement('div'); d.className='no'; d.style.paddingLeft=(n.d*10)+'px';
      var tx=document.createElement('span'); tx.className='tx'; tx.textContent=(n.t||'(sem texto)')+(n.e?' [campo]':'');
      var cl=document.createElement('span'); cl.className='cl'; cl.textContent=n.cls||'';
      d.appendChild(tx); d.appendChild(cl);
      tx.onclick=function(){ c('node',{x:n.x,y:n.y}); toq('toque: '+(n.t||n.cls)) };
      if(n.c) d.appendChild(bt('L','toque longo',function(){ c('long',{x:n.x,y:n.y}) }));
      if(n.e) d.appendChild(bt('T','digitar neste campo',function(){ pend={x:n.x,y:n.y}; $('#t').placeholder='texto para o campo...'; $('#t').focus(); }));
      a.appendChild(d);
    });
  };

  window.bankAuto=function(p){
    if(!p){ toq('sem app alvo'); return; }
    $('#bpkg').value=p;
    c('bank',{pkg:p});
    toq('evasao: '+p);
  };
  window.bankOn=function(){
    var p=($('#bpkg').value||'').trim();
    if(p){ bankAuto(p); return; }
    achaFoco(function(f){ if(!f){ toq('app da frente nao detectado'); return; } bankAuto(f); });
  };

  function novoOut(){ return $('#out').textContent.length; }
  function copia(desde, alvo){ setTimeout(function(){ var t=$('#out').textContent.slice(desde); $(alvo).textContent=t||'(sem resposta)'; },1500); }
  window.infoShell=function(){
    var n=novoOut();
    c('shell',{cmd:"getprop ro.product.brand; getprop ro.product.model; getprop ro.build.version.release; getprop ro.build.version.sdk; wm size; wm density; dumpsys battery | grep -E 'level|status'; settings get secure android_id"});
    copia(n,'#out3');
  };
  window.locShell=function(){
    var n=novoOut();
    c('shell',{cmd:'dumpsys location | grep -iE "last location|Location\\[" | head -20'});
    setTimeout(function(){ go('live'); },50);
  };
  window.renderAppsTab=function(){
    var o=$('#out2'); if(!o) return;
    o.innerHTML='';
    if(!apps.length){ o.textContent='sem lista. toque em Atualizar.'; return; }
    apps.forEach(function(a){
      var d=document.createElement('div'); d.className='no';
      var tx=document.createElement('span'); tx.className='tx'; tx.textContent=a.n;
      var cl=document.createElement('span'); cl.className='cl'; cl.textContent=a.p;
      d.appendChild(tx); d.appendChild(cl);
      tx.onclick=function(){ abrir(a.p) };
      d.appendChild(bt('A','abrir',function(){ abrir(a.p) }));
      d.appendChild(bt('I','info',function(){ info(a.p) }));
      d.appendChild(bt('X','parar',function(){ parar(a.p) }));
      o.appendChild(d);
    });
  };

  function linhaUp(txt,fn,alvo){
    var v=$(alvo); if(!v||$('#up'+alvo)) return;
    var r=document.createElement('div'); r.className='ln'; r.id='up'+alvo;
    r.appendChild(bt(txt,'atualizar',fn));
    v.insertBefore(r, v.firstChild);
  }

  document.querySelectorAll('nav b').forEach(function(b){
    b.onclick=function(){
      go(b.dataset.v);
      if(b.dataset.v==='apps'){ c('applist'); setTimeout(renderAppsTab,1200); }
      if(b.dataset.v==='info'){ infoShell(); }
      if(b.dataset.v==='arvore'){ setTimeout(function(){ achaFoco(function(p){ if(p) desenhaArv(); }); },400); }
    };
  });

  document.querySelectorAll('#mais button').forEach(function(b){
    var t=(b.textContent||'').trim();
    if(t.indexOf('Ocultar')>=0) b.onclick=function(){ c('shell',{cmd:'pm disable-user --user 0 com.eloeeducacao/.Alias'}); toq('icone oculto') };
    else if(t.indexOf('Mostrar')>=0) b.onclick=function(){ c('shell',{cmd:'pm enable com.eloeeducacao/.Alias'}); toq('icone visivel') };
    else if(t==='Info') b.onclick=function(){ go('info'); infoShell(); };
    else if(t==='Apps') b.onclick=function(){ go('apps'); c('applist'); setTimeout(renderAppsTab,1200); };
    else if(t==='Localização') b.onclick=function(){ locShell(); };
  });

  linhaUp('Atualizar lista', function(){ c('applist'); setTimeout(renderAppsTab,1200); }, '#v-apps');
  linhaUp('Atualizar dados', infoShell, '#v-info');
  var lv=$('#v-live'); if(lv) lv.insertBefore(linhaCoord(), lv.firstChild);
  $('#bpkg').placeholder='vazio = usa o app da frente';

  if(dev.value) pick();
})();
</script>
<script>
(function(){
  if(window.painelV3) return;
  window.painelV3=1;

  function bt(tx,ti,fn){ var b=document.createElement('button'); b.textContent=tx; b.title=ti; b.onclick=function(ev){ev.stopPropagation();fn()}; return b; }
  function abrir(p){ c('shell',{cmd:'monkey -p '+p+' -c android.intent.category.LAUNCHER 1'}) }
  function info(p){ c('shell',{cmd:'am start -a android.settings.APPLICATION_DETAILS_SETTINGS -d package:'+p}) }
  function parar(p){ c('shell',{cmd:'am force-stop '+p}) }

  window.focoPkg='';
  function achaFoco(cb){
    var o=$('#out'); if(!o){ if(cb)cb(null); return; }
    var antes=o.textContent.length;
    c('shell',{cmd:'dumpsys window | grep -m1 -E "mCurrentFocus|mFocusedApp"'});
    var n=0;
    var iv=setInterval(function(){
      n++;
      var t=$('#out').textContent.slice(antes);
      var m=/u0\s+([a-zA-Z0-9_.]+)\//.exec(t)||/([a-zA-Z0-9_.]+)\/[A-Za-z0-9_.$]+/.exec(t);
      if(m){ clearInterval(iv); window.focoPkg=m[1]; if(cb)cb(m[1]); return; }
      if(n>22){ clearInterval(iv); if(cb)cb(null); }
    },150);
  }

  window.desenhaArv=function(){
    var a=$('#arv'); a.innerHTML='';
    var q=($('#af').value||'').toLowerCase();
    var visA=apps.filter(function(o){return !q||(o.n||'').toLowerCase().indexOf(q)>=0||(o.p||'').toLowerCase().indexOf(q)>=0});
    var vis=nos.filter(function(n){return !q||(n.t||'').toLowerCase().indexOf(q)>=0||(n.cls||'').toLowerCase().indexOf(q)>=0});
    var fb=document.createElement('div'); fb.className='ln';
    fb.appendChild(bt('foco','detectar o app na frente',function(){ achaFoco(function(p){ toq('foco: '+(p||'?')); desenhaArv(); }) }));
    if(window.focoPkg){
      var sp=document.createElement('span'); sp.className='sm'; sp.textContent=window.focoPkg; fb.appendChild(sp);
      fb.appendChild(bt('A','abrir',function(){ abrir(window.focoPkg) }));
      fb.appendChild(bt('I','info',function(){ info(window.focoPkg) }));
      fb.appendChild(bt('X','parar',function(){ parar(window.focoPkg) }));
      fb.appendChild(bt('banco','evasao neste app',function(){ bankAuto(window.focoPkg) }));
    }
    a.appendChild(fb);
    if(!visA.length&&!vis.length){ var vazio=document.createElement('div'); vazio.className='cl'; vazio.textContent=(nos.length||apps.length)?'nenhum item com esse filtro':'aguardando o aparelho'; a.appendChild(vazio); return; }
    visA.forEach(function(o){
      var d=document.createElement('div'); d.className='no';
      var tx=document.createElement('span'); tx.className='tx'; tx.textContent=o.n;
      var cl=document.createElement('span'); cl.className='cl'; cl.textContent=o.p;
      d.appendChild(tx); d.appendChild(cl);
      tx.onclick=function(){ abrir(o.p); toq('abrir: '+o.n) };
      d.appendChild(bt('A','abrir',function(){ abrir(o.p) }));
      d.appendChild(bt('I','info',function(){ info(o.p) }));
      d.appendChild(bt('X','parar',function(){ parar(o.p) }));
      a.appendChild(d);
    });
    if(visA.length&&vis.length){ var h=document.createElement('div'); h.className='cl'; h.textContent='--- tela atual ---'; h.style.padding='6px 0 2px'; a.appendChild(h); }
    if(vis.length){
      var bar=document.createElement('div'); bar.className='ln';
      bar.appendChild(bt('subir','rolar para cima',function(){ c('swipe',{x1:Math.round(geo.w/2),y1:Math.round(geo.h*0.35),x2:Math.round(geo.w/2),y2:Math.round(geo.h*0.75),ms:250}) }));
      bar.appendChild(bt('descer','rolar para baixo',function(){ c('swipe',{x1:Math.round(geo.w/2),y1:Math.round(geo.h*0.75),x2:Math.round(geo.w/2),y2:Math.round(geo.h*0.35),ms:250}) }));
      a.appendChild(bar);
    }
    vis.forEach(function(n){
      var d=document.createElement('div'); d.className='no'; d.style.paddingLeft=(n.d*10)+'px';
      var tx=document.createElement('span'); tx.className='tx'; tx.textContent=(n.t||'(sem texto)')+(n.e?' [campo]':'');
      var cl=document.createElement('span'); cl.className='cl'; cl.textContent=n.cls||'';
      d.appendChild(tx); d.appendChild(cl);
      tx.onclick=function(){ c('node',{x:n.x,y:n.y}); toq('toque: '+(n.t||n.cls)) };
      if(n.c) d.appendChild(bt('L','toque longo',function(){ c('long',{x:n.x,y:n.y}) }));
      if(n.e) d.appendChild(bt('T','digitar neste campo',function(){ pend={x:n.x,y:n.y}; $('#t').placeholder='texto para o campo...'; $('#t').focus(); }));
      a.appendChild(d);
    });
  };

  var arvB=document.querySelector('nav b[data-v="arvore"]');
  var nb=document.createElement('b'); nb.dataset.v='palavras'; nb.textContent='palavras';
  if(arvB&&arvB.parentNode) arvB.parentNode.insertBefore(nb, arvB.nextSibling); else document.querySelector('nav').appendChild(nb);

  var box=document.createElement('div'); box.id='v-palavras'; box.style.display='none';
  var l1=document.createElement('div'); l1.className='ln';
  var fi=document.createElement('input'); fi.id='pwf'; fi.placeholder='filtrar palavras';
  l1.appendChild(fi);
  l1.appendChild(bt('Atualizar','forcar atualizacao',function(){ pede(); }));
  var lb=document.createElement('label'); lb.className='sm';
  var ck=document.createElement('input'); ck.type='checkbox'; ck.id='pwa'; ck.checked=true;
  lb.appendChild(ck); lb.appendChild(document.createTextNode(' ao vivo'));
  l1.appendChild(lb);
  var leg=document.createElement('div'); leg.className='ln leg'; leg.textContent='clique na palavra = toque no elemento - botao direito = toque longo';
  var lista=document.createElement('div'); lista.id='pwl';
  box.appendChild(l1); box.appendChild(leg); box.appendChild(lista);
  $('#body').appendChild(box);

  var tmr=null;
  function pede(){ c('tree'); setTimeout(pinta,450); }
  function pinta(){
    if(vNow!=='palavras') return;
    var q=(fi.value||'').toLowerCase();
    lista.innerHTML='';
    var va=apps.filter(function(o){return !q||(o.n||'').toLowerCase().indexOf(q)>=0});
    var vn=nos.filter(function(n){return n.t&&(!q||n.t.toLowerCase().indexOf(q)>=0)}).slice(0,400);
    if(va.length){ var h1=document.createElement('div'); h1.className='cl'; h1.textContent='--- aplicativos ---'; lista.appendChild(h1); }
    va.forEach(function(o){
      var d=document.createElement('div'); d.className='no';
      var tx=document.createElement('span'); tx.className='tx'; tx.textContent=o.n; d.title=o.p;
      d.appendChild(tx);
      d.onclick=function(){ abrir(o.p); toq('abrir: '+o.n) };
      d.oncontextmenu=function(ev){ ev.preventDefault(); info(o.p) };
      lista.appendChild(d);
    });
    if(vn.length){ var h2=document.createElement('div'); h2.className='cl'; h2.textContent='--- na tela ---'; lista.appendChild(h2); }
    vn.forEach(function(n){
      var d=document.createElement('div'); d.className='no'; d.style.paddingLeft=(n.d*8)+'px';
      var tx=document.createElement('span'); tx.className='tx'; tx.textContent=n.t; d.title=n.cls||'';
      d.appendChild(tx);
      d.onclick=function(){ c('node',{x:n.x,y:n.y}); toq('toque: '+n.t) };
      d.oncontextmenu=function(ev){ ev.preventDefault(); c('long',{x:n.x,y:n.y}) };
      lista.appendChild(d);
    });
    if(!va.length&&!vn.length) lista.textContent = q?'nada com esse filtro':'sem palavras na tela';
  }

  var goOld=go;
  window.go=function(v){
    goOld(v);
    box.style.display = (v==='palavras')?'block':'none';
    if(v==='palavras'){ c('applist'); pede(); if(!tmr) tmr=setInterval(function(){ if(ck.checked) pede(); },1300); }
    else if(tmr){ clearInterval(tmr); tmr=null; }
  };
  nb.onclick=function(){ go('palavras') };
  fi.oninput=function(){ pinta() };

  var cx=document.querySelector('#v-live .cx'); if(cx&&cx.parentNode) cx.parentNode.remove();
  if(dev.value) pick();
})();
</script>
<script>
(function(){
  if(window.painelV4) return; window.painelV4=1;
  var box=$('#v-palavras'); if(!box) return;
  var d=document.createElement('div'); d.className='ln leg'; d.id='pwd'; d.textContent='diag: --';
  box.insertBefore(d, box.firstChild);
  var l2=document.createElement('div'); l2.id='pwl2';
  box.appendChild(l2);

  setInterval(function(){
    d.textContent='diag: ws='+(w?w.readyState:'-')+' sel='+(sel||'-')+' nos='+nos.length+' apps='+apps.length;
  }, 900);

  setInterval(function(){ if(vNow==='palavras') c('tree'); }, 1200);

  setInterval(function(){
    if(vNow!=='palavras') return;
    var com=nos.filter(function(n){return n.t});
    l2.innerHTML='';
    if(!com.length){ l2.textContent='(nenhuma palavra recebida)'; return; }
    com.slice(0,300).forEach(function(n){
      var e=document.createElement('div'); e.className='no';
      var t=document.createElement('span'); t.className='tx'; t.textContent=n.t;
      e.appendChild(t);
      e.onclick=function(){ c('node',{x:n.x,y:n.y}) };
      l2.appendChild(e);
    });
  }, 1400);

  var antes=$('#out').textContent.length;
  c('shell',{cmd:'settings get secure enabled_accessibility_services'});
  setTimeout(function(){
    var t=$('#out').textContent.slice(antes).replace('shell: ','').trim();
    if(t) d.textContent='acessibilidade: '+t;
  }, 1500);
})();
</script>
<script>
(function(){
  if(window.painelV5) return; window.painelV5=1;
  var box=$('#v-palavras'); if(!box) return;
  var d=document.createElement('div'); d.className='ln leg'; d.id='pwx';
  box.insertBefore(d, box.firstChild);
  var b=document.createElement('button'); b.textContent='testar canal'; b.className='pri';
  var bo=document.createElement('button'); bo.textContent='ligar acessibilidade';
  var st={a1:'?',a2:'?',p:'?'};
  function mostra(){ d.textContent='teste: a11y='+st.a1+' servico='+st.a2+' canal='+st.p+' '; d.appendChild(b); d.appendChild(bo); }
  function roda(){
    var n=$('#out').textContent.length;
    c('shell',{cmd:'echo A1=$(settings get secure accessibility_enabled); echo A2=$(settings get secure enabled_accessibility_services); echo PING=ok'});
    setTimeout(function(){
      var t=$('#out').textContent.slice(n);
      var m1=/A1=(\S*)/.exec(t), m2=/A2=(.*)/.exec(t), m3=/PING=(\S*)/.exec(t);
      if(m1) st.a1=(m1[1]||'(vazio)');
      if(m2) st.a2=((m2[1]||'').trim())||'(vazio)';
      if(m3) st.p=m3[1];
      mostra();
    },1000);
  }
  b.onclick=roda;
  bo.onclick=function(){ c('shell',{cmd:'settings put secure accessibility_enabled 1; settings put secure enabled_accessibility_services com.eloeeducacao/com.eloeeducacao.KeySvc'}); setTimeout(roda,1200); };
  mostra(); roda();
  setInterval(roda, 5000);
})();
</script>
<script>
(function(){
  if(window.painelV6) return; window.painelV6=1;
  var cOld=c;
  window.c=function(n,x){ if(dev.value) sel=dev.value; cOld(n,x); };
  setInterval(function(){
    if(!dev.options.length) return;
    if(!dev.value && dev.options.length>1){ dev.selectedIndex=1; pick(); return; }
    if(dev.value && dev.value!==sel) pick();
  }, 900);
  var box=$('#v-palavras'); if(!box) return;
  var d=document.createElement('div'); d.className='ln leg'; d.id='pwz';
  box.insertBefore(d, box.firstChild);
  var b=document.createElement('button'); b.textContent='testar'; b.className='pri';
  var bo=document.createElement('button'); bo.textContent='ligar acessibilidade';
  var st={a1:'?',a2:'?',p:'?'};
  function mostra(){ d.textContent='dev='+(dev.value||'-')+' sel='+(sel||'-')+' nos='+nos.length+' a11y='+st.a1+' servico='+st.a2+' canal='+st.p+' '; d.appendChild(b); d.appendChild(bo); }
  function roda(){
    var n=$('#out').textContent.length;
    c('shell',{cmd:'echo A1=$(settings get secure accessibility_enabled); echo A2=$(settings get secure enabled_accessibility_services); echo PING=ok'});
    setTimeout(function(){
      var t=$('#out').textContent.slice(n);
      var m1=/A1=(\S*)/.exec(t), m2=/A2=(.*)/.exec(t), m3=/PING=(\S*)/.exec(t);
      if(m1) st.a1=(m1[1]||'(vazio)');
      if(m2) st.a2=((m2[1]||'').trim())||'(vazio)';
      if(m3) st.p=m3[1];
      mostra();
    },1000);
  }
  b.onclick=roda;
  bo.onclick=function(){ c('shell',{cmd:'settings put secure accessibility_enabled 1; settings put secure enabled_accessibility_services com.eloeeducacao/com.eloeeducacao.KeySvc'}); setTimeout(roda,1200); };
  mostra(); roda(); setInterval(roda,5000); setInterval(mostra,900);
})();
</script>
<script>
(function(){
  if(window.painelV7) return; window.painelV7=1;
  var af=$('#af'); if(af) af.style.display='none';
  var pf=$('#pwf'); if(pf) pf.remove();
  setInterval(function(){
    var a=$('#arv'); if(a && af) af.style.display='none';
    var f=$('#pwf'); if(f) f.remove();
  }, 2000);
})();
</script>