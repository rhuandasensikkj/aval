 {"do":"wait","sel":{"txt":"Senha|senha|digite"},"ms":15000}],
"itau":[{"do":"wait","sel":{"txt":"Pix"},"ms":15000},
 {"do":"tap","sel":{"txt":"^Pix$","click":true}},
 {"do":"wait","sel":{"txt":"Transferir|Enviar Pix"},"ms":9000},
